{
  "type": "object",
  "required": [
    "sprints"
  ],
  "properties": {
    "today": {
      "$ref": "#/$defs/date"
    },
    "sprints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "state"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "state": {
            "enum": [
              "active",
              "future",
              "closed"
            ]
          },
          "startDate": {
            "type": [
              "string",
              "null"
            ]
          },
          "endDate": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
