{
  "type": "object",
  "required": [
    "today",
    "sprint",
    "tickets"
  ],
  "properties": {
    "today": {
      "$ref": "#/$defs/date"
    },
    "sprint": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "end": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "tickets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "status",
          "category"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "category": {
            "enum": [
              "new",
              "indeterminate",
              "done"
            ]
          },
          "review": {
            "type": "boolean"
          },
          "dueDate": {
            "type": [
              "string",
              "null"
            ]
          },
          "pr": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "merged": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "targetMatches": {
                "type": "boolean"
              }
            }
          },
          "missingDoneFields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
