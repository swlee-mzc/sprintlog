{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sprint",
    "items"
  ],
  "properties": {
    "sprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "start",
        "end"
      ],
      "properties": {
        "n": {
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "$ref": "#/$defs/date"
        },
        "end": {
          "$ref": "#/$defs/date"
        },
        "id": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "startDate",
          "dueDate",
          "hours"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "startDate": {
            "$ref": "#/$defs/date"
          },
          "dueDate": {
            "$ref": "#/$defs/date"
          },
          "hours": {
            "type": "number",
            "minimum": 0
          },
          "fixed": {
            "type": "boolean"
          }
        }
      }
    },
    "applied": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
