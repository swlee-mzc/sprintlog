{
  "type": "object",
  "required": ["today", "subtasks"],
  "properties": {
    "today": { "$ref": "#/$defs/date" },
    "subtasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "mine", "done"],
        "properties": {
          "key": { "type": "string" },
          "status": { "type": ["string", "null"] },
          "subtask": { "type": "boolean" },
          "parentKey": { "type": ["string", "null"] },
          "mine": { "type": "boolean" },
          "done": { "type": "boolean" },
          "dropped": { "type": "boolean" },
          "dueDate": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "merged": { "type": "object", "additionalProperties": { "type": ["boolean", "null"] } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
